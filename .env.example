# Copy to .env. `./run.sh` fills ENCRYPTION_KEY the first time it runs.

HOST=127.0.0.1
PORT=8000
VOCALYZE_ENV=development
DATA_DIR=./var/vocalyze

# Backends: mock | whisper | pyannote | llm
ASR_BACKEND=mock
DIARIZATION_BACKEND=mock
SUMMARIZER_BACKEND=mock

# Privacy
REQUIRE_CONSENT=true
ENCRYPT_AT_REST=true
ENCRYPTION_KEY=
DELETE_AUDIO_AFTER_ASR=true
REDACT_PII=true
ALLOW_EXTERNAL_LLM=false
RETENTION_HOURS=24
RETENTION_SWEEP_SECONDS=300
AUDIT_LOG_ENABLED=true

# Grounding
MIN_EVIDENCE_OVERLAP=0.55
DROP_UNGROUNDED_CLAIMS=true

# Real models (only if the backend is switched from mock)
WHISPER_MODEL=large-v3
PYANNOTE_MODEL=pyannote/speaker-diarization-3.1
HUGGINGFACE_TOKEN=
LLM_BASE_URL=
LLM_MODEL=llama3.1
LLM_API_KEY=
